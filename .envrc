# Ambiente do LevainPeak: cria o .venv se faltar, ativa e instala o projeto (pip install -e .) se ainda não estiver.
if [ ! -d .venv ]; then
    echo "Criando .venv com $(python3 -V)"
    python3 -m venv .venv
fi
source .venv/bin/activate
if ! python -c "import levainpeak" 2>/dev/null; then
    echo "Instalando o LevainPeak no .venv (pip install -e .)"
    pip install -e .
fi
