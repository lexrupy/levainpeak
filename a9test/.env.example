# Copie para .env e preencha. O .env é gitignored.
#
# Como obter (com a câmera na mesma rede):
#   python3 /tmp/opencode/a9test/A9/a9_discover.py --show-secret --save-config
# ou copie os valores do a9_camera.json gerado na descoberta.
#
# A9_IP      IP da câmera na LAN
# A9_PORT    porta pprpc (padrão 20190)
# A9_DID     identificador do dispositivo (ex.: PPHWA9...)
# A9_SECRET  paired_auth_secret (ex.: $L8$...)
A9_IP=
A9_PORT=20190
A9_DID=
A9_SECRET=
